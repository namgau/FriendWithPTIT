PORT=3000
DATABASE_URL=postgresql://fwp:fwp@localhost:5432/fwp
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
DEMO_OTP=123456
SEED_DEMO=true
DB_SYNCHRONIZE=true
CAMPUS_UPLOAD_DIR=./uploads/campus
CAMPUS_MAX_IMAGE_BYTES=4194304
CAMPUS_REPORT_HIDE_THRESHOLD=5
AI_BASE_URL=http://localhost:8000
DB_MIGRATIONS_RUN=false
REQUEST_BODY_LIMIT=24mb
CAMPUS_MEDIA_URL_TTL_SECONDS=86400
# CAMPUS_MEDIA_SECRET=change-me   (defaults to JWT_SECRET)
# CAMPUS_MODERATOR_USER_IDS=<uuid>,<uuid>   (moderation API is closed when empty)

# Key Gemini (Google AI Studio) cho nhân vật demo Phùng Thanh Mộ ; để trống thì nhân vật trả lời câu dự phòng.
# Mỗi người tự dán vào backend/.env, KHÔNG commit key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Hoặc key Grok (console.x.ai) ; có key này thì ưu tiên Grok hơn Gemini.
XAI_API_KEY=
# XAI_MODEL=grok-3-mini
